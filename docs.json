{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Motive",
  "logo": {
    "dark": "/logo/dark.svg",
    "light": "/logo/light.svg",
    "href": "https://github.com/Recxsmacx/Motive"
  },
  "favicon": "/favicon.svg",
  "colors": {
    "primary": "#8B5CF6",
    "light": "#A78BFA",
    "dark": "#7C3AED"
  },
  "assistant": {
    "enabled": true
  },
  "seo": {
    "indexing": "all"
  },
  "topbarLinks": [
    {
      "name": "Main Website",
      "url": "https://github.com/Recxsmacx/Motive"
    },
    {
      "name": "Playground",
      "url": "https://github.com/Recxsmacx/Motive"
    }
  ],
  "topbarCtaButton": {
    "name": "GitHub Repo",
    "url": "https://github.com/Recxsmacx/Motive"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Getting Started",
        "groups": [
          {
            "group": "Overview",
            "pages": ["introduction"]
          },
          {
            "group": "Installation & Setup",
            "pages": ["quickstart", "installation"]
          }
        ]
      },
      {
        "tab": "Usage & Props",
        "groups": [
          {
            "group": "Core Concepts",
            "pages": ["usage", "triggers", "controlled-mode"]
          },
          {
            "group": "API Reference",
            "pages": ["props-reference", "exports"]
          }
        ]
      },
      {
        "tab": "Contributing & Architecture",
        "groups": [
          {
            "group": "Guides",
            "pages": ["add-new-icon", "monorepo-setup"]
          }
        ]
      }
    ]
